{
  "name": "solarsystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:watch": "ng build --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
