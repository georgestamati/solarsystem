{
  "name": "solarsystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "start:dev": "nodemon server/server.js",
    "build": "ng build",
    "serve": "ng serve",
    "dev": "concurrently \"npm run start:dev\" \"npm run serve\"",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "compression": "^1.7.1",
    "express": "~4.15.2",
    "memory-cache": "^0.2.0",
    "morgan": "~1.8.1",
    "ngx-cookie-service": "^21.3.1",
    "rxjs": "~7.8.0",
    "serve-favicon": "~2.4.2",
    "socket.io": "^2.0.3",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.0.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.0.0",
    "typescript": "~5.9.2"
  },
  "author": "George Stamati",
  "license": "ISC"
}
